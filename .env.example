APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Storage timezone (Carbon/now()); keep UTC unless you know what you're doing.
APP_TIMEZONE=UTC
# Presentation timezone — dates are RENDERED in this zone via App\Support\LocalTime.
APP_DISPLAY_TIMEZONE=America/Lima

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Laravel Nightwatch
NIGHTWATCH_ENABLED=false
NIGHTWATCH_TOKEN=
NIGHTWATCH_REQUEST_SAMPLE_RATE=0.1
NIGHTWATCH_COMMAND_SAMPLE_RATE=1.0
NIGHTWATCH_EXCEPTION_SAMPLE_RATE=1.0
NIGHTWATCH_SCHEDULED_TASK_SAMPLE_RATE=1.0
NIGHTWATCH_CAPTURE_REQUEST_PAYLOAD=false
NIGHTWATCH_REDACT_HEADERS=Authorization,Cookie,Set-Cookie,Proxy-Authorization,X-XSRF-TOKEN,X-CSRF-TOKEN,X-API-Key
NIGHTWATCH_REDACT_PAYLOAD_FIELDS=_token,password,password_confirmation,token,api_key,secret,nightwatch_token,sentry_dsn,firebase,supabase,huggingface,fcm_token,qr_token,remember_token,personal_access_token
NIGHTWATCH_LOG_LEVEL=debug
NIGHTWATCH_IGNORE_CACHE_EVENTS=false
NIGHTWATCH_IGNORE_MAIL=false
NIGHTWATCH_IGNORE_NOTIFICATIONS=false
NIGHTWATCH_IGNORE_OUTGOING_REQUESTS=false
NIGHTWATCH_IGNORE_QUERIES=false
# In Laravel Cloud, Connect Nightwatch may set:
# LOG_CHANNEL=stack
# LOG_STACK=laravel-cloud-socket,nightwatch

SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=${APP_ENV}
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false
SENTRY_ENABLE_LOGS=false

TRUSTED_PROXIES=*

SECURITY_HEADERS_FRAME_OPTIONS=SAMEORIGIN
SECURITY_HEADERS_CONTENT_TYPE_OPTIONS=nosniff
SECURITY_HEADERS_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_HEADERS_PERMISSIONS_POLICY="camera=(), geolocation=(), microphone=()"
SECURITY_HEADERS_COOP=same-origin
SECURITY_HEADERS_CORP=same-origin
SECURITY_HEADERS_CSP_MODE=report-only
SECURITY_HEADERS_CSP="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' https://fonts.bunny.net; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
SECURITY_HEADERS_ENABLE_HSTS=true
SECURITY_HEADERS_FORCE_HSTS=false
SECURITY_HEADERS_HSTS_MAX_AGE=31536000
SECURITY_HEADERS_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HEADERS_HSTS_PRELOAD=false

DB_CONNECTION=pgsql
DB_HOST=your-project-ref.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=replace_me
DATABASE_URL=
DB_SSLMODE=require
# Keep true with Supabase Transaction Pooler (6543).
# Avoid direct boolean bindings in filters; use model scopes with IS TRUE/IS FALSE.
DB_EMULATE_PREPARES=true
ALLOW_SQLITE_IN_PRODUCTION=false

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_URL=
# REDIS_HOST=redis      ← use this when Laravel runs INSIDE Docker Compose (service name resolves via infra-network)
# REDIS_HOST=127.0.0.1  ← use this for local `php artisan serve` on Windows (Docker exposes port 6379 to host)
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# DB slots: 0=default, 1=cache, 2=queue, 3=session
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3

# Named Redis connections used by cache/queue config
REDIS_CACHE_CONNECTION=cache
REDIS_QUEUE_CONNECTION=queue

# Set to true to require Redis for health checks in production
REDIS_HEALTH_REQUIRED=false

# ── Local development without Redis ──────────────────────────────────────────
# CACHE_STORE=file
# QUEUE_CONNECTION=sync
# SESSION_DRIVER=file
# REDIS_HEALTH_REQUIRED=false
#
# ── Local development WITH Redis (Docker: `docker compose up -d redis`) ──────
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=file      ← keep file until cache/queue are confirmed stable
# REDIS_HOST=127.0.0.1
# REDIS_HEALTH_REQUIRED=false
#
# Worker (required when QUEUE_CONNECTION=redis):
#   php artisan queue:work redis --queue=ai,notifications,media,default --sleep=1 --timeout=180 --max-time=3600
#
# Verify Redis is running:
#   docker exec -it infra-redis redis-cli ping   → PONG

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="notifications@tu-dominio-verificado.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend (canal de email transaccional — ver docs/... ):
#   RESEND_API_KEY viene del dashboard de Resend (re_xxxxxxxxx).
#   RESEND_WEBHOOK_SECRET viene del webhook registrado en Resend (whsec_xxxxxxxxx).
#   No usar onboarding@resend.dev como MAIL_FROM_ADDRESS en producción.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx
RESEND_WEBHOOK_TOLERANCE=300

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_ROLE_SYNC_ENABLED=false
SUPABASE_TIMEOUT=10
SUPABASE_AUTH_ADMIN_USERS_ENDPOINT=/auth/v1/admin/users

SUPABASE_STORAGE_API_BASE_URL=${SUPABASE_URL}
SUPABASE_STORAGE_PUBLIC_BASE_URL=${SUPABASE_URL}
SUPABASE_STORAGE_SERVICE_KEY=${SUPABASE_SERVICE_ROLE_KEY}
SUPABASE_STORAGE_TIMEOUT=10
SUPABASE_STORAGE_USE_LOCAL_DISK_FOR_TESTING=true
SUPABASE_STORAGE_TESTING_DISK=public

SUPABASE_BUCKET_CATEGORIES=TicketCategoria
SUPABASE_BUCKET_LOCATIONS=TablaLocations
SUPABASE_BUCKET_TICKETS=TableTicket
SUPABASE_PUBLIC_BUCKET=TableTicket
SUPABASE_BUCKET_USERS=TablaUsers

SUPABASE_PREFIX_CATEGORIES=categories/icons
SUPABASE_PREFIX_LOCATIONS=locations/qr-codes
SUPABASE_PREFIX_TICKETS=tickets/media
SUPABASE_PREFIX_USERS=users/avatars

VITE_APP_NAME="${APP_NAME}"

# Locations similarity
LOCATION_DUPLICATE_DETECTION_ENABLED=true
LOCATION_SIMILARITY_THRESHOLD=0.75
LOCATION_DUPLICATE_ACTIVE_ONLY=true
LOCATION_SIMILARITY_MAX_CANDIDATES=100

# Dashboard cache (progressive rollout — set to false to bypass without code changes)
DASHBOARD_CACHE_ENABLED=true
DASHBOARD_CACHE_TTL_REPORTER=45

# AI / Dedup
FEATURE_IA_ENABLED=true
FEATURE_SEMANTIC_DEDUP=true
TICKET_DEDUP_SIMILARITY_THRESHOLD=0.90
TICKET_DEDUP_OBSERVATION_THRESHOLD=0.82
TICKET_DEDUP_TITLE_OVERLAP_MIN_TOKENS=1
TICKET_DEDUP_WINDOW_HOURS=24
TICKET_AI_ASYNC_PROCESSING=true

# Auto-asignacion al Jefe de Practica responsable de la ubicacion (opt-in).
# Con false (default) el comportamiento del sistema no cambia en absoluto.
TICKET_AUTO_ASSIGN_BY_LOCATION=false
